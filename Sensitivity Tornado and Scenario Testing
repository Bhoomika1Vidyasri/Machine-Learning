#Import Libraries
import pandas as pd
import numpy as np
from sklearn.ensemble import RandomForestRegressor, GradientBoostingRegressor
from sklearn.linear_model import LinearRegression
from xgboost import XGBRegressor
from lightgbm import LGBMRegressor
from sklearn.model_selection import train_test_split, cross_val_score, KFold
from sklearn.metrics import r2_score, mean_squared_error
import shap
import matplotlib.pyplot as plt
from scipy.optimize import minimize, Bounds
from sklearn.utils import resample
import optuna
from scipy.stats import f_oneway, kruskal, spearmanr
from google.colab import files
import skfuzzy as fuzz
from sklearn.inspection import permutation_importance
from pymoo.core.problem import ElementwiseProblem
from pymoo.optimize import minimize as pymoo_minimize
from pymoo.algorithms.moo.nsga2 import NSGA2
from pymoo.termination import get_termination  # ✅ FIXED IMPORT

#Upload Data
uploaded = files.upload()
df = pd.read_excel("Altered google form data (2).xlsx", sheet_name="Form responses 1")

#Drop Metadata
metadata = ['Timestamp', 'Email address', 'Name of the respondent:', 'Gender',
            'Year of professional experience of respondent:', 'Type of respondent:']
stakeholder_col = 'Type of respondent:'
df_meta = df[metadata] if stakeholder_col in df.columns else pd.DataFrame()
df = df.drop(columns=[col for col in metadata if col in df.columns])

#Clean Likert responses
df = df.apply(pd.to_numeric, errors='coerce').dropna()

#Simulated Score and Rating
max_total_score = df.shape[1] * 5
df['Total Score'] = df.sum(axis=1)
df['Percent Score'] = (df['Total Score'] / max_total_score) * 100

def assign_rating(score):
    if score >= 85:
        return 'Platinum'
    elif score >= 75:
        return 'Gold'
    elif score >= 65:
        return 'Silver'
    elif score >= 50:
        return 'Certified'
    else:
        return 'Below Certified'

df['Simulated Rating'] = df['Percent Score'].apply(assign_rating)

#Features and Target
X = df.drop(columns=['Total Score', 'Percent Score', 'Simulated Rating'])
y = df['Percent Score']

#Define IGBC/GRIHA-aligned Categories
categories = {
    'Energy Efficiency': [col for col in X.columns if 'energy' in col.lower()],
    'Water Efficiency': [col for col in X.columns if 'water' in col.lower()],
    'Indoor Air Quality': [col for col in X.columns if 'air quality' in col.lower() or 'indoor' in col.lower()],
    'Materials & Resources': [col for col in X.columns if 'material' in col.lower()],
    'Cost': [col for col in X.columns if 'cost' in col.lower()],
}

#Fit model for optimization reference
model = RandomForestRegressor(n_estimators=100, random_state=42)
model.fit(X, y)

#Multi-objective Optimization with Pareto Front (Updated)
class SustainabilityProblem(ElementwiseProblem):
    def __init__(self):
        super().__init__(n_var=X.shape[1],
                         n_obj=2,
                         n_constr=0,
                         xl=np.ones(X.shape[1]),
                         xu=np.ones(X.shape[1])*5)

    def _evaluate(self, x, out, *args, **kwargs):
        x_df = pd.DataFrame([x], columns=X.columns)
        score = -model.predict(x_df)[0]
        cost_features = [i for i, col in enumerate(X.columns) if col in categories['Cost']]
        cost = np.mean([x[i] for i in cost_features]) if cost_features else 0
        out["F"] = [cost, score]

problem = SustainabilityProblem()
algorithm = NSGA2(pop_size=50)
termination = get_termination("n_gen", 50)
res = pymoo_minimize(problem, algorithm, termination, seed=1, verbose=False)

F = res.F
plt.figure(figsize=(8, 6))
plt.scatter(F[:, 0], -F[:, 1], c='blue', edgecolors='k')
plt.xlabel("Cost (Mean of Cost-related Likert)")
plt.ylabel("Predicted Sustainability Score")
plt.title("Pareto Front: Cost vs Sustainability")
plt.grid(True)
plt.savefig("pareto_front_plot.png", bbox_inches='tight')
plt.close()
files.download("pareto_front_plot.png")

#Scenario Plot for Best Trade-offs
pareto_df = pd.DataFrame(res.X, columns=X.columns)
pareto_df['Cost'] = F[:, 0]
pareto_df['Score'] = -F[:, 1]

best_idx = np.argmax(pareto_df['Score'])
low_cost_idx = np.argmin(pareto_df['Cost'])
mid_idx = np.argsort(pareto_df['Score'])[len(pareto_df)//2]

scenarios = pareto_df.loc[[low_cost_idx, mid_idx, best_idx]]
scenarios.index = ['Low Cost', 'Balanced', 'High Score']
scenarios[X.columns].T.plot(kind='bar', figsize=(12, 6))
plt.title("Scenario Feature Values: Cost vs Performance Trade-offs")
plt.ylabel("Likert Score")
plt.xlabel("Feature")
plt.legend(title="Scenario")
plt.xticks(rotation=90)
plt.tight_layout()
plt.savefig("scenario_comparison_plot.png", bbox_inches='tight')
plt.close()
files.download("scenario_comparison_plot.png")

#Sensitivity Tornado Plot
perm = permutation_importance(model, X, y, n_repeats=30, random_state=42)
tornado_df = pd.DataFrame({
    'Feature': X.columns,
    'Importance': perm.importances_mean
}).sort_values(by='Importance', ascending=True)

plt.figure(figsize=(10, 6))
plt.barh(tornado_df['Feature'], tornado_df['Importance'], color='skyblue')
plt.xlabel("Permutation Importance")
plt.title("Sensitivity Tornado Plot")
plt.tight_layout()
plt.savefig("sensitivity_tornado_plot.png", bbox_inches='tight')
plt.close()
files.download("sensitivity_tornado_plot.png")
